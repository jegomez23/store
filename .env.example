# Plantilla de variables de entorno. Copiar a .env.local y rellenar con
# valores reales. NUNCA commitear .env.local ni valores reales aquí.
# Detalle completo: docs/11-ENVIRONMENT.md

# ── Supabase (esquema versionado en supabase/migrations/; aplicado y
# validado contra un proyecto real en Fase 4.5 — ver CURRENT-STATE.md) ───
# Públicas: seguras para el navegador. La seguridad real vive en RLS
# (docs/rules/security.md), no en ocultar estas claves.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Secreto de servidor. JAMÁS con prefijo NEXT_PUBLIC_, jamás en componentes
# client, jamás en commits. Solo se usará desde lib/supabase/admin.ts
# (server-only) cuando exista una razón real server-side — aún sin uso por
# código de aplicación (Fase 4.5 solo la usó para pruebas de validación).
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Sitio ───────────────────────────────────────────────────────────────
# URL pública canónica (metadataBase, futuro sitemap/OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mercado (consumido por lib/markets.ts desde Fase 4) ─────────────────
# Mercado activo del deploy: 'ES' | 'CO'. DEC-014: España es el mercado
# inicial operativo (docs/context/DECISIONS.md).
NEXT_PUBLIC_MARKET=ES

# ── Asistente de catálogo (incremento 21, OPCIONAL) ─────────────────────
# Proveedor: Gemini (Google), tramo gratuito permanente y sin tarjeta.
# Se consigue en https://aistudio.google.com/apikey
#
# HACEN FALTA DOS COSAS para que el asistente funcione, y son distintas:
#   1. esta clave, aquí, en el servidor;
#   2. el interruptor «Ayuda con IA» encendido en /admin/ajustes (0045),
#      que nace APAGADO a propósito.
#
# Sin cualquiera de las dos el panel funciona igual: el botón «Analizar
# foto» sale desactivado, la pantalla dice cuál de las dos falta y la ficha
# se rellena a mano. La IA es un acelerador, nunca una dependencia
# (docs/context/AI-DEVELOPMENT.md §29).
#
# Secreto de servidor: JAMÁS con prefijo NEXT_PUBLIC_, jamás en el código.
# GEMINI_API_KEY=<api-key>
# Modelo, opcional. Por defecto gemini-3.5-flash (del tramo gratuito).
# GEMINI_PRODUCT_MODEL=gemini-3.5-flash
