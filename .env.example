# Plantilla de variables de entorno. Copiar a .env.local y rellenar con
# valores reales. NUNCA commitear .env.local ni valores reales aquí.
# Detalle completo: docs/11-ENVIRONMENT.md

# ── Supabase (esquema versionado en supabase/migrations/, Fase 3; proyecto
# real aún no provisionado — ver docs/context/CURRENT-STATE.md) ──────────
# Públicas: seguras para el navegador. La seguridad real vive en RLS
# (docs/rules/security.md), no en ocultar estas claves.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Secreto de servidor. JAMÁS con prefijo NEXT_PUBLIC_, jamás en componentes
# client, jamás en commits. Solo se usará desde lib/supabase/admin.ts
# (server-only) cuando exista una razón real server-side — aún sin uso.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Sitio ───────────────────────────────────────────────────────────────
# URL pública canónica (metadataBase, futuro sitemap/OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mercado (preparado en esquema/seed; aún no consumido por código de
# aplicación — lib/markets.ts no existe todavía) ─────────────────────────
# Mercado activo del deploy: 'ES' | 'CO'. DEC-014: España es el mercado
# inicial operativo (docs/context/DECISIONS.md).
NEXT_PUBLIC_MARKET=ES
